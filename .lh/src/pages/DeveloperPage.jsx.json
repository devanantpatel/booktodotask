            "content": "import React from 'react';\r\nimport DocLayout from './DocLayout';\r\nimport { Mail, Phone, ExternalLink } from 'lucide-react';\r\n\r\nconst GithubIcon = ({ size = 15, className = \"\" }) => (\r\n  <svg width={size} height={size} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={className}>\r\n    <path d=\"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4\" />\r\n    <path d=\"M9 18c-4.51 2-5-2-7-2\" />\r\n  </svg>\r\n);\r\n\r\nexport default function DeveloperPage() {\r\n  return (\r\n    <DocLayout \r\n      title=\"About the Developer\" \r\n      subtitle=\"Engineering behind BookToDoTask Workspace\"\r\n    >\r\n      <div className=\"flex flex-col sm:flex-row items-center sm:items-start gap-5 pb-6 border-b border-stone-800\">\r\n        <div className=\"w-20 h-20 rounded-2xl bg-gradient-to-tr from-amber-600 to-amber-400 flex items-center justify-center text-stone-950 font-black text-3xl shadow-xl shrink-0\">\r\n          A\r\n        </div>\r\n        <div className=\"text-center sm:text-left\">\r\n          <h2 className=\"text-lg font-black text-stone-100\">Anant Patel</h2>\r\n          <p className=\"text-xs text-amber-400 font-semibold mt-0.5\">React & Node.js Developer</p>\r\n          <p className=\"text-xs text-stone-400 mt-2 leading-relaxed\">\r\n            Specializing in high-performance web applications, interactive canvas engines, and clean client-side architectures. Dedicated to building responsive tools that balance aesthetic design with functional reliability.\r\n          </p>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"space-y-3 pt-2\">\r\n        <h3 className=\"text-xs font-black text-amber-300 uppercase tracking-wider\">Contact & Profiles</h3>\r\n        \r\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\r\n          <a\r\n            href=\"https://github.com/devanantpatel\"\r\n            target=\"_blank\"\r\n            rel=\"noreferrer\"\r\n            className=\"flex items-center justify-between p-3 rounded-xl bg-stone-900/80 hover:bg-stone-850 border border-stone-800 transition group\"\r\n          >\r\n            <div className=\"flex items-center gap-2.5\">\r\n              <GithubIcon size={16} className=\"text-amber-400\" />\r\n              <span className=\"text-xs font-semibold text-stone-200\">github.com/devanantpatel</span>\r\n            </div>\r\n            <ExternalLink size={13} className=\"text-stone-500 group-hover:text-amber-400 transition\" />\r\n          </a>\r\n\r\n          <a\r\n            href=\"mailto:devanantpatel@gmail.com\"\r\n            className=\"flex items-center gap-2.5 p-3 rounded-xl bg-stone-900/80 hover:bg-stone-850 border border-stone-800 transition\"\r\n          >\r\n            <Mail size={16} className=\"text-amber-400\" />\r\n            <span className=\"text-xs font-semibold text-stone-200\">devanantpatel@gmail.com</span>\r\n          </a>\r\n\r\n          <a\r\n            href=\"tel:7607765685\"\r\n            className=\"flex items-center gap-2.5 p-3 rounded-xl bg-stone-900/80 hover:bg-stone-850 border border-stone-800 transition\"\r\n          >\r\n            <Phone size={16} className=\"text-amber-400\" />\r\n            <span className=\"text-xs font-semibold text-stone-200\">+91 7607765685</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </DocLayout>\r\n  );\r\n}"
